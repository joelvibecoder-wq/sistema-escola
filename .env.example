# Copie para .env SOMENTE na sua máquina. Nunca publique valores reais.
# Node 20+: inicie com: node --env-file=.env server.js
NODE_ENV=development
PORT=10000

# Conexão privada do banco PostgreSQL. Preencha fora do Git.
DATABASE_URL=

# 32+ caracteres gerados aleatoriamente, diferente do token administrativo.
SESSION_SECRET=

# Ativação inicial da administração (uma única vez).
# Preencher com endereço AUTORIZADO e token aleatório de 32+ caracteres.
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_TOKEN=

# Integração Google opcional; configure origem autorizada no Google Cloud.
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAIL=

# Confirmação real dos cadastros por e-mail (configure também no Render).
# O remetente precisa ser domínio validado no Resend.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=https://kennedy-vota-app.onrender.com
