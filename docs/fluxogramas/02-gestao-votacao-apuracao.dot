digraph Votacao {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.52", splines=polyline, fontname="DejaVu Sans"];
node [fontname="DejaVu Sans", fontsize=13, margin="0.20,0.13", color="#255341", penwidth=1.5, fontcolor="#18382b", style=filled, fillcolor="#f3faf5"];
edge [fontname="DejaVu Sans", fontsize=11, color="#416451", arrowsize=.68, penwidth=1.2];
titulo [shape=plaintext, fontsize=22, fontcolor="#14532d", label="KENNEDY VOTA | 02 - GESTÃO, VOTO E APURAÇÃO"];
inicio [shape=oval, label="INÍCIO", fillcolor="#d2f1dc"];
criar [shape=box, label="Admin cria eleição Planejada\ncom datas e público"];
candidatos [shape=box, label="Cadastrar candidaturas"];
requisitos [shape=diamond, label="Ao menos 2 candidatos\ne data final futura?", fillcolor="#fff4cf"];
ajustar [shape=box, label="Ajustar datas ou candidatos"];
abrir [shape=box, label="Administrador abre eleição"];
periodo [shape=diamond, label="Status Aberta e\ndentro do período?", fillcolor="#fff4cf"];
aguardar [shape=parallelogram, label="Exibir votação indisponível"];
escolher [shape=parallelogram, label="Eleitor seleciona eleição\ne candidato"];
elegivel [shape=diamond, label="Conta aprovada e\nperfil elegível?", fillcolor="#fff4cf"];
restrito [shape=parallelogram, label="Informar acesso não permitido"];
votou [shape=diamond, label="Já votou nessa\neleição?", fillcolor="#fff4cf"];
duplicado [shape=parallelogram, label="Impedir segundo voto"];
correto [shape=diamond, label="Candidato\nválido?", fillcolor="#fff4cf"];
invalido [shape=parallelogram, label="Pedir seleção válida"];
confirmar [shape=box, label="Confirmar o voto"];
gravar [shape=box, label="Gravar participação e cédula\nna mesma transação SQL"];
concluido [shape=parallelogram, label="Exibir voto registrado"];
encerrada [shape=diamond, label="Eleição encerrada ou\nprazo final atingido?", fillcolor="#fff4cf"];
bloqueado [shape=parallelogram, label="Apuração ainda indisponível"];
apurar [shape=parallelogram, label="Consultar / exportar apuração"];
excluir [shape=diamond, label="Admin deseja\nexcluir a eleição?", fillcolor="#fff4cf"];
manter [shape=box, label="Manter eleição e registros"];
confirmar_exclusao [shape=parallelogram, label="Digitar EXCLUIR e\nconfirmar título exato"];
confirmado [shape=diamond, label="Confirmação\ncorreta?", fillcolor="#fff4cf"];
cancelar [shape=box, label="Preservar eleição"];
apagar [shape=box, label="Apagar cédulas, participações,\ncandidatos e eleição"];
fim1 [shape=oval, label="FIM", fillcolor="#d2f1dc"];
fim2 [shape=oval, label="FIM", fillcolor="#d2f1dc"];
fim3 [shape=oval, label="FIM", fillcolor="#d2f1dc"];
fim4 [shape=oval, label="FIM", fillcolor="#d2f1dc"];
titulo -> inicio [style=invis]; inicio -> criar -> candidatos -> requisitos;
requisitos -> ajustar [label="Não"];
ajustar -> fim1;
requisitos -> abrir [label="Sim"];
abrir -> periodo;
periodo -> aguardar [label="Não"];
aguardar -> fim1;
periodo -> escolher [label="Sim"];
escolher -> elegivel;
elegivel -> restrito [label="Não"];
restrito -> fim2;
elegivel -> votou [label="Sim"];
votou -> duplicado [label="Sim"];
duplicado -> fim2;
votou -> correto [label="Não"];
correto -> invalido [label="Não"];
invalido -> fim2;
correto -> confirmar [label="Sim"];
confirmar -> gravar -> concluido -> encerrada;
encerrada -> bloqueado [label="Não"];
bloqueado -> fim3;
encerrada -> apurar [label="Sim"];
apurar -> excluir;
excluir -> manter [label="Não"];
manter -> fim4;
excluir -> confirmar_exclusao [label="Sim"];
confirmar_exclusao -> confirmado;
confirmado -> cancelar [label="Não"];
cancelar -> fim4;
confirmado -> apagar [label="Sim"];
apagar -> fim4;
}