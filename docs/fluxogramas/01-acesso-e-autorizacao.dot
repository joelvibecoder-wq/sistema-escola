digraph Acesso {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.37", ranksep="0.52", splines=polyline, fontname="DejaVu Sans"];
node [fontname="DejaVu Sans", fontsize=13, margin="0.20,0.13", color="#255341", penwidth=1.5, fontcolor="#18382b", style=filled, fillcolor="#f3faf5"];
edge [fontname="DejaVu Sans", fontsize=11, color="#416451", arrowsize=.68, penwidth=1.2];
titulo [shape=plaintext, fontsize=23, fontcolor="#14532d", label="KENNEDY VOTA | 01 - ACESSO E AUTORIZAÇÃO"];
inicio [shape=oval, label="INÍCIO", fillcolor="#d2f1dc"];
abrir [shape=box, label="Abrir o aplicativo"];
possui [shape=diamond, label="Já possui\nconta?", fillcolor="#fff4cf"];
cadastro [shape=parallelogram, label="Informar nome, e-mail,\nsenha e perfil"];
valido [shape=diamond, label="Dados do\ncadastro válidos?", fillcolor="#fff4cf"];
erro_cadastro [shape=box, label="Mostrar erro e\ncorrigir dados"];
enviar [shape=box, label="Criar conta e enviar\nconfirmação por e-mail"];
confirmado [shape=diamond, label="E-mail\nconfirmado?", fillcolor="#fff4cf"];
aguardar [shape=box, label="Aguardar link válido\nde confirmação"];
login [shape=parallelogram, label="Entrar com senha ou Google\n(quando configurado)"];
acesso [shape=diamond, label="Credenciais\nválidas?", fillcolor="#fff4cf"];
negar [shape=box, label="Exibir falha de acesso"];
banido [shape=diamond, label="Conta\nbloqueada?", fillcolor="#fff4cf"];
motivo [shape=parallelogram, label="Exibir tela de bloqueio\ne o motivo"];
aprov [shape=diamond, label="Cadastro\naprovado?", fillcolor="#fff4cf"];
pendente [shape=parallelogram, label="Exibir painel e aviso\nde aprovação pendente"];
admin [shape=diamond, label="É administrador?", fillcolor="#fff4cf"];
gerenciar [shape=box, label="Gerenciar usuários, bloqueios,\ncandidatos e eleições"];
participar [shape=box, label="Consultar eleições e\nvotar quando elegível"];
fim_ok [shape=oval, label="FIM", fillcolor="#d2f1dc"];
fim_pendente [shape=oval, label="FIM", fillcolor="#d2f1dc"];
fim_negado [shape=oval, label="FIM", fillcolor="#d2f1dc"];
fim_cadastro [shape=oval, label="FIM", fillcolor="#d2f1dc"];
titulo -> inicio [style=invis]; inicio -> abrir -> possui;
possui -> cadastro [label="Não"];
possui -> login [label="Sim"];
cadastro -> valido;
valido -> erro_cadastro [label="Não"];
erro_cadastro -> fim_cadastro;
valido -> enviar [label="Sim"];
enviar -> confirmado;
confirmado -> aguardar [label="Não"];
aguardar -> fim_cadastro;
confirmado -> login [label="Sim"];
login -> acesso;
acesso -> negar [label="Não"];
negar -> fim_negado;
acesso -> banido [label="Sim"];
banido -> motivo [label="Sim"];
motivo -> fim_negado;
banido -> aprov [label="Não"];
aprov -> pendente [label="Não"];
pendente -> fim_pendente;
aprov -> admin [label="Sim"];
admin -> gerenciar [label="Sim"];
admin -> participar [label="Não"];
gerenciar -> fim_ok;
participar -> fim_ok;
}